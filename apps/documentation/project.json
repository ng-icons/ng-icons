{
  "name": "documentation",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/documentation/src",
  "prefix": "app",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@analogjs/platform:vite",
      "outputs": ["{workspaceRoot}/dist/apps/documentation"],
      "cache": false,
      "options": {
        "configFile": "apps/documentation/vite.config.ts",
        "outputPath": "dist/apps/documentation/client",
        "main": "apps/documentation/src/main.ts",
        "tsConfig": "apps/documentation/tsconfig.app.json"
      },
      "defaultConfiguration": "production",
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@analogjs/platform:vite-dev-server",
      "options": {
        "buildTarget": "documentation:build",
        "port": 4200
      },
      "defaultConfiguration": "development",
      "configurations": {
        "development": {
          "buildTarget": "documentation:build:development"
        },
        "production": {
          "buildTarget": "documentation:build:production"
        }
      },
      "continuous": true
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{projectRoot}/../../coverage/apps/documentation"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
